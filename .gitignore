# ============================================================================
#  Raw & third-party data — NEVER committed; regenerated by the fetch scripts.
# ============================================================================
# ~71 GB of FASTQs (data/download_ena.sh) — NB: .gitignore has no inline comments,
# so these MUST stay on their own lines (a trailing "# ..." would break the pattern).
data/ena/raw/
*.fastq
*.fastq.gz
*.fq.gz
# Heavy-step checkpoints remain ignored, but the small portable Phase-5 inputs
# and machine-readable impact results are release evidence and are committed.
data/derived/*
!data/derived/impact_*.tsv
!data/derived/impact_*.json
#  (report/_freeze/ is deliberately COMMITTED — it's the Quarto freeze:auto cache.)

# Perry et al. 2024 publisher files (data/download_published.sh re-fetches them):
data/published/*.xlsx
data/published/*.zip
data/published/supplementary_code_1/
data/metadata/supplementary_data_1_covariates.csv
docs/supplementary_information.pdf

# NOTE: deliberately COMMITTED (small, public, makes the verification reproducible):
#   data/ena/PRJEB48362_read_run.tsv             (ENA metadata)
#   data/metadata/conwy_12S_libraries.tsv        (derived join table)
#   data/metadata/design_gaps.tsv                (derived)
#   data/metadata/conwy_covariates.tsv           (derived, BOM-free covariates — P3)
#   data/metadata/source_data_12S_normalised.tsv (derived 665×68 12S matrix — P1)
#   data/metadata/occasions.tsv                  (derived occasion/NA map — P5)
#   data/metadata/*_verification.md              (computed verification reports)

# ============================================================================
#  R / renv
# ============================================================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# ============================================================================
#  Stan / cmdstanr compiled artifacts (keep the .stan sources only)
# ============================================================================
stan/**/*.hpp
stan/**/*.o
*.stan.d

# ============================================================================
#  Quarto / output
# ============================================================================
/_site/
.quarto/
report/*_files/
report/*_cache/
*_files/
/tmp/

# ============================================================================
#  OS / editor
# ============================================================================
.DS_Store
.Rproj.user
*~
.vscode/

# ============================================================================
#  Kept locally, not published
# ============================================================================
__pycache__/
*.pyc
# build product (regenerate with scripts/package_website.py; ship as a Release asset)
output/share/
.venv*/
